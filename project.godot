; Engine configuration file.
config_version=5

[application]

config/name="Heroes of the Shattered Crown"
config/description="A turn-based fantasy strategy game in the spirit of Heroes of Might and Magic."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameData="*res://scripts/core/game_data.gd"
Assets="*res://scripts/core/assets.gd"
Audio="*res://scripts/core/audio.gd"
GameState="*res://scripts/core/game_state.gd"
Shot="*res://scripts/core/shot.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
